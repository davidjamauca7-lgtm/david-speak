function optCls(c, o, i) {
  if (!c.answered) return '';
  if (o === c.answer) return 'correct';
  if (i === c.chosen) return 'wrong';
  return '';
}

function feedbackHTML(c) {
  const ans = c.type === 'reorder' ? c.w.ex
            : c.type === 'type' || c.type === 'speak' ? c.w.en
            : c.answer;
  return `
    <div class="feedback ${c.ok ? 'ok' : 'bad'}">${c.ok ? '¡Correcto! +10 XP' : 'Respuesta: ' + esc(ans)}</div>
    <p class="example muted">${esc(c.w.ex)}<br>${esc(c.w.exEs)}</p>`;
}

function exerciseBody(c) {
  const w = c.w;
  const a = c.answered;
  const dis = a ? 'disabled' : '';

  if (c.type === 'mc') {
    return `<div class="quiz-q">${esc(c.prompt)}</div>` +
      c.opts.map((o, i) => `<button class="option ${optCls(c, o, i)}" ${dis} onclick="answerChoice(${i})">${esc(o)}</button>`).join('');
  }

  if (c.type === 'listen') {
    return `<div class="center">
        <button class="speak-big" data-say="${esc(w.en)}" onclick="sayEl(this)" aria-label="Escuchar ${esc(w.en)}">🔊</button>
        ${pronunciationHint(w)}
        <p class="muted">Toca el altavoz para escuchar y elige el significado</p>
      </div>` +
      c.opts.map((o, i) => `<button class="option ${optCls(c, o, i)}" ${dis} onclick="answerChoice(${i})">${esc(o)}</button>`).join('');
  }

  if (c.type === 'type') {
    return `<div class="quiz-q">Escribe en inglés:<br>«${esc(w.es)}»</div>
      <form onsubmit="event.preventDefault();submitType()">
        <input id="ans" class="input" autocomplete="off" autocapitalize="none" placeholder="Tu respuesta"
               value="${esc(c.typed)}" ${dis} ${a ? '' : 'autofocus'}>
        ${a ? '' : '<button class="btn" type="submit">Comprobar</button>'}
      </form>`;
  }

  if (c.type === 'reorder') {
    const built = c.build.map((ti, k) => {
      const cls = a ? (ti === k ? 'ok' : 'bad') : '';
      return `<button class="chip ${cls}" ${dis} onclick="unbuild(${k})">${esc(c.tokens[ti])}</button>`;
    }).join('');
    const bank = c.bank.filter(ti => !c.build.includes(ti))
      .map(ti => `<button class="chip" onclick="build(${ti})">${esc(c.tokens[ti])}</button>`).join('');
    const full = c.build.length === c.tokens.length;
    return `<div class="quiz-q">Ordena la frase:<br><span class="muted" style="font-size:1rem">${esc(w.exEs)}</span></div>
      <div class="chips">${built || '<span class="muted">Toca las palabras en orden</span>'}</div>
      ${a ? '' : `<div class="bank">${bank}</div>
      <button class="btn" ${full ? '' : 'disabled'} onclick="checkReorder()">Comprobar</button>`}`;
  }

  if (c.type === 'speak') {
    return `<div class="quiz-q">Di en voz alta:<br>«${esc(w.en)}»</div>
      <p class="muted center">${esc(w.es)}</p>
      <div class="center">
        <button class="speak-big" data-say="${esc(w.en)}" onclick="sayEl(this)" aria-label="Escuchar pronunciación de ${esc(w.en)}">🔊</button>
        ${pronunciationHint(w)}
        <p class="muted">Escucha primero y luego toca el micrófono para practicar</p>
        <button class="speak-big" ${a || c.listening ? 'disabled' : ''} onclick="startMic()" aria-label="Grabar pronunciación">🎤</button>
        <p class="muted" id="status">${esc(c.status)}</p>
      </div>
      ${a ? '' : c.manual
        ? `<form onsubmit="event.preventDefault();submitType()">
            <label class="muted" for="ans">Si el micrófono no funciona, escribe lo que dijiste:</label>
            <input id="ans" class="input" autocomplete="off" autocapitalize="none" placeholder="Tu respuesta en inglés" value="${esc(c.typed)}">
            <button class="btn" type="submit">Comprobar respuesta</button>
          </form>`
        : '<div class="center"><button class="link" onclick="showManualAnswer()">¿Problemas con el micrófono? Escribir respuesta</button></div>'}
      ${a ? '' : '<div class="center"><button class="link" onclick="skip()">Saltar por ahora</button></div>'}
      <p class="muted center">David Speak no guarda grabaciones; el navegador reconoce la voz.</p>`;
  }
  return '';
}

