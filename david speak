<script>
/* =====================================================================
   CONTENIDO
   W(inglés, español, emoji, ejemplo en inglés, ejemplo en español)
   ===================================================================== */
const W = (en, es, emoji, ex, exEs, pronunciation = '') => ({ en, es, emoji, ex, exEs, pronunciation });

const CONTENT = [
  { id: 'saludos', title: 'Saludos', icon: '👋', lessons: [
    { id: 's1', title: 'Hola y adiós', words: [
      W('Hello','Hola','👋','Hello my friend','Hola mi amigo'),
      W('Goodbye','Adiós','🙋','Goodbye see you tomorrow','Adiós nos vemos mañana'),
      W('Good morning','Buenos días','🌅','Good morning Maria','Buenos días María'),
      W('Good night','Buenas noches','🌙','Good night sleep well','Buenas noches duerme bien'),
      W('Thank you','Gracias','😊','Thank you for the help','Gracias por la ayuda') ]},
    { id: 's2', title: 'Presentarte', words: [
      W('My name is...','Me llamo...','🪪','My name is Carlos','Me llamo Carlos'),
      W('How are you?','¿Cómo estás?','🤔','How are you today','Cómo estás hoy'),
      W('I am fine','Estoy bien','👍','I am fine thanks','Estoy bien gracias'),
      W('Nice to meet you','Mucho gusto','🤝','Nice to meet you Ana','Mucho gusto Ana'),
      W('Please','Por favor','🙏','Water please','Agua por favor') ]}
  ]},
  { id: 'numeros', title: 'Números', icon: '🔢', lessons: [
    { id: 'n1', title: 'Del 1 al 5', words: [
      W('One','Uno','1️⃣','I have one dog','Tengo un perro'),
      W('Two','Dos','2️⃣','I have two cats','Tengo dos gatos'),
      W('Three','Tres','3️⃣','Three books on the table','Tres libros en la mesa'),
      W('Four','Cuatro','4️⃣','Four people are here','Cuatro personas están aquí'),
      W('Five','Cinco','5️⃣','I want five apples','Quiero cinco manzanas') ]},
    { id: 'n2', title: 'Del 6 al 10', words: [
      W('Six','Seis','6️⃣','Six days a week','Seis días a la semana'),
      W('Seven','Siete','7️⃣','Seven is my lucky number','Siete es mi número de la suerte'),
      W('Eight','Ocho','8️⃣','Eight hours of sleep','Ocho horas de sueño'),
      W('Nine','Nueve','9️⃣','It is nine oclock','Son las nueve'),
      W('Ten','Diez','🔟','Ten dollars please','Diez dólares por favor') ]}
  ]},
  { id: 'comida', title: 'Comida', icon: '🍎', lessons: [
    { id: 'c1', title: 'Frutas y bebidas', words: [
      W('Apple','Manzana','🍎','I eat an apple','Como una manzana'),
      W('Banana','Plátano','🍌','The banana is yellow','El plátano es amarillo'),
      W('Orange','Naranja','🍊','I drink orange juice','Bebo jugo de naranja'),
      W('Water','Agua','💧','I want water','Quiero agua'),
      W('Milk','Leche','🥛','I like milk','Me gusta la leche') ]},
    { id: 'c2', title: 'En el restaurante', words: [
      W('Bread','Pan','🍞','Bread and butter','Pan y mantequilla'),
      W('Coffee','Café','☕','I want a coffee','Quiero un café'),
      W('I am hungry','Tengo hambre','🍽️','I am hungry now','Tengo hambre ahora'),
      W('The bill please','La cuenta por favor','🧾','The bill please','La cuenta por favor'),
      W('Delicious','Delicioso','😋','This food is delicious','Esta comida es deliciosa') ]}
  ]},
  { id: 'viajes', title: 'Viajes', icon: '✈️', lessons: [
    { id: 'v1', title: 'Moverte por la ciudad', words: [
      W('Bus','Autobús','🚌','The bus is late','El autobús llega tarde'),
      W('Train','Tren','🚆','The train is fast','El tren es rápido'),
      W('Airport','Aeropuerto','🛫','The airport is big','El aeropuerto es grande'),
      W('Hotel','Hotel','🏨','I have a hotel room','Tengo una habitación de hotel'),
      W('Where is...?','¿Dónde está...?','📍','Where is the bathroom','Dónde está el baño') ]},
    { id: 'v2', title: 'Pedir ayuda', words: [
      W('Ticket','Boleto','🎫','I need a ticket','Necesito un boleto'),
      W('Passport','Pasaporte','🛂','My passport is here','Mi pasaporte está aquí'),
      W('Left','Izquierda','⬅️','Turn left at the store','Gira a la izquierda en la tienda'),
      W('Right','Derecha','➡️','Turn right here','Gira a la derecha aquí'),
      W('Map','Mapa','🗺️','I have a map','Tengo un mapa') ]}
  ]},
  { id: 'rutina', title: 'Rutina diaria', icon: '⏰', lessons: [
    { id: 'r1', title: 'La mañana', words: [
      W('Wake up','Despertarse','⏰','I wake up at seven','Me despierto a las siete'),
      W('Shower','Ducharse','🚿','I take a shower','Me ducho','sháu-er (fuerza en «sháu»; sonido /ʃ/ al inicio)'),
      W('Breakfast','Desayuno','🥣','I eat breakfast at home','Desayuno en casa'),
      W('Work','Trabajar','💼','I work every day','Trabajo todos los días'),
      W('Sleep','Dormir','😴','I sleep at night','Duermo de noche') ]},
    { id: 'r2', title: 'La tarde', words: [
      W('Lunch','Almuerzo','🥪','Lunch is at noon','El almuerzo es al mediodía'),
      W('Study','Estudiar','📖','I study English','Estudio inglés'),
      W('Read','Leer','📚','I read every night','Leo cada noche'),
      W('Walk','Caminar','🚶','I walk to school','Camino a la escuela'),
      W('Music','Música','🎵','I listen to music','Escucho música') ]}
  ]},
  { id: 'familia', title: 'Familia', icon: '👨‍👩‍👧', lessons: [
    { id: 'f1', title: 'Miembros de la familia', words: [
      W('Mother','Madre','👩','My mother is kind','Mi madre es amable'),
      W('Father','Padre','👨','My father is tall','Mi padre es alto'),
      W('Brother','Hermano','👦','My brother likes football','A mi hermano le gusta el fútbol'),
      W('Sister','Hermana','👧','My sister is smart','Mi hermana es inteligente'),
      W('Friend','Amigo','🧑','He is my best friend','Él es mi mejor amigo') ]},
    { id: 'f2', title: 'Descripciones', words: [
      W('Big','Grande','📏','The house is big','La casa es grande'),
      W('Small','Pequeño','🤏','The cat is small','El gato es pequeño'),
      W('New','Nuevo','✨','I have a new car','Tengo un carro nuevo'),
      W('Old','Viejo','🧓','This book is old','Este libro es viejo'),
      W('Happy','Feliz','😄','I am very happy','Estoy muy feliz') ]}
  ]}
];

/* Índice plano de todas las palabras */
const ALL = CONTENT.flatMap(u => u.lessons.flatMap(l => l.words));
const BY_EN = Object.fromEntries(ALL.map(w => [w.en, w]));

/* =====================================================================
   CONFIGURACIÓN Y ESTADO
   ===================================================================== */
const KEY = 'lexinube-v2';
const DAILY_GOAL = 30;
const SR_CLASS = window.SpeechRecognition || window.webkitSpeechRecognition || null;
const DEF = { xp: 0, streak: 0, lastDay: 0, freezes: 0, daily: { day: 0, xp: 0 },
              words: {}, lessons: {}, stats: { total: 0, correct: 0 } };

const clone = o => JSON.parse(JSON.stringify(o));
function load() {
  try {
    const d = JSON.parse(localStorage.getItem(KEY) || 'null');
    return d ? { ...clone(DEF), ...d } : clone(DEF);
  } catch (e) { return clone(DEF); }
}
let S = load();
let view = { screen: 'home' };
let sess = null;

function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} }
function dayStart(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); }

/* Racha con congelador: se gana uno cada 7 días y protege un día perdido */
function touchActivity() {
  const t = dayStart(new Date());
  if (S.daily.day !== t) S.daily = { day: t, xp: 0 };
  if (S.lastDay === t) return;
  const diff = S.lastDay ? Math.round((t - S.lastDay) / 864e5) : 0;
  if (diff === 1) S.streak++;
  else if (diff === 2 && S.freezes > 0) { S.freezes--; S.streak++; }
  else S.streak = 1;
  S.lastDay = t;
  if (S.streak % 7 === 0) S.freezes = Math.min(2, S.freezes + 1);
}
function addXP(n) {
  touchActivity();
  S.xp += n;
  S.daily.xp += n;
}
function level() { return Math.floor(S.xp / 100) + 1; }
function todayXP() { return S.daily.day === dayStart(new Date()) ? S.daily.xp : 0; }

/* =====================================================================
   REPETICIÓN ESPACIADA (inspirada en SM-2 simplificado)
   ===================================================================== */
function srs(en, ok) {
  const s = S.words[en] || (S.words[en] = { reps: 0, ease: 2.5, interval: 0, due: 0, seen: 0, correct: 0 });
  s.seen++;
  const now = Date.now();
  if (ok) {
    s.correct++;
    s.reps++;
    s.interval = s.reps === 1 ? 1 : s.reps === 2 ? 3 : Math.round(s.interval * s.ease);
    s.ease = Math.min(3.0, s.ease + 0.1);
    s.due = now + s.interval * 864e5;
  } else {
    s.reps = 0;
    s.interval = 0;
    s.ease = Math.max(1.3, s.ease - 0.2);
    s.due = now + 10 * 6e4; // reaparece en 10 minutos
  }
  save();
}
function statusOf(en) {
  const s = S.words[en];
  if (!s) return ['Nueva', ''];
  if (s.reps >= 3) return ['Dominada', 'dominada'];
  if (s.reps > 0) return ['Aprendiendo', 'aprendiendo'];
  return ['Repasar', 'repasar'];
}
function dueWords() {
  return Object.keys(S.words)
    .filter(en => BY_EN[en] && S.words[en].due <= Date.now())
    .sort((a, b) => S.words[a].due - S.words[b].due);
}
function masteredCount() { return Object.values(S.words).filter(s => s.reps >= 3).length; }

/* =====================================================================
   UTILIDADES
   ===================================================================== */
function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}
function pronunciationHint(w) {
  return w.pronunciation ? `<p class="muted pronunciation">Aproximado: ${esc(w.pronunciation)}</p>` : '';
}
function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
function norm(s) {
  return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
    .replace(/[^a-z0-9\s]/g, '').replace(/\s+/g, ' ').trim();
}
function lev(a, b) {
  const m = [];
  for (let i = 0; i <= a.length; i++) { m[i] = [i]; }
  for (let j = 0; j <= b.length; j++) { m[0][j] = j; }
  for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) {
    m[i][j] = Math.min(m[i-1][j] + 1, m[i][j-1] + 1, m[i-1][j-1] + (a[i-1] === b[j-1] ? 0 : 1));
  }
  return m[a.length][b.length];
}
function others(field, excl, n) {
  const out = [];
  for (const x of shuffle(ALL)) {
    const v = x[field];
    if (v !== excl && !out.includes(v)) { out.push(v); if (out.length === n) break; }
  }
  return out;
}
async function speak(text) {
  if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) {
    setAudioStatus('Este navegador no admite la reproducción de voz.', 'error');
    return;
  }
  const synth = window.speechSynthesis;
  const request = ++speechRequest;
  synth.cancel();
  setAudioStatus(`Preparando audio de «${text}»…`);
  let voices = synth.getVoices();
  const findEnglishVoice = list => list.find(v => v.lang.toLowerCase() === 'en-us')
    || list.find(v => v.lang.toLowerCase().startsWith('en-'))
    || list.find(v => v.lang.toLowerCase() === 'en');
  if (!findEnglishVoice(voices)) {
    voices = await new Promise(resolve => {
      const timer = setTimeout(() => {
        synth.removeEventListener('voiceschanged', onVoicesChanged);
        resolve(synth.getVoices());
      }, 500);
      function onVoicesChanged() {
        const available = synth.getVoices();
        if (findEnglishVoice(available)) {
          clearTimeout(timer);
          synth.removeEventListener('voiceschanged', onVoicesChanged);
          resolve(available);
        }
      }
      synth.addEventListener('voiceschanged', onVoicesChanged);
    });
  }
  if (request !== speechRequest) return;
  const englishVoice = findEnglishVoice(voices);
  const u = new SpeechSynthesisUtterance(text);
  u.lang = englishVoice ? englishVoice.lang : 'en-US';
  u.rate = 0.78;
  u.pitch = 1;
  u.volume = 1;
  if (englishVoice) u.voice = englishVoice;
  const fallback = englishVoice ? '' : ' No hay una voz inglesa disponible; instala o activa una voz en inglés en los ajustes del dispositivo.';
  u.onstart = () => {
    if (request === speechRequest) setAudioStatus(`Reproduciendo «${text}».${fallback}`, englishVoice ? 'info' : 'error');
  };
  u.onend = () => {
    if (request === speechRequest) setAudioStatus(`Audio terminado.${fallback}`, englishVoice ? 'info' : 'error');
  };
  u.onerror = e => {
    if (request !== speechRequest) return;
    const message = e.error === 'not-allowed'
      ? 'El navegador bloqueó el audio. Toca Escuchar otra vez y comprueba el volumen del dispositivo.'
      : e.error === 'voice-unavailable'
        ? 'No hay una voz de inglés disponible. Instala una voz inglesa en los ajustes de voz del dispositivo.'
        : 'No se pudo reproducir el audio. Comprueba el volumen del dispositivo e inténtalo de nuevo.';
    setAudioStatus(message, 'error');
  };
  synth.resume();
  synth.speak(u);
}
let speechRequest = 0;
function setAudioStatus(message, tone = '') {
  document.querySelectorAll('[data-audio-status]').forEach(el => {
    el.textContent = message;
    el.className = `audio-status ${tone}`;
  });
}
function sayEl(el) { speak(el.dataset.say); }

/* Tipos de ejercicio disponibles para una palabra */
function candidates(w) {
  const t = ['mc', 'type', 'listen'];
  if (w.ex) t.push('reorder');
  if (SR_CLASS) t.push('speak');
  return t;
}
function otherType(cur, w) {
  const t = candidates(w).filter(x => x !== cur);
  return t.length ? pick(t) : cur;
}

/* =====================================================================
   SESIONES
   ===================================================================== */
function startLesson(ui, li) {
  const lesson = CONTENT[ui].lessons[li];
  const queue = [];
  lesson.words.forEach(w => {
    const full = BY_EN[w.en];
    shuffle(candidates(full)).slice(0, 2).forEach(type => queue.push({ w: full, type }));
  });
  beginSession('lesson', shuffle(queue), { lessonId: lesson.id, title: lesson.title });
}
function startReview() {
  const queue = dueWords().slice(0, 12).map(en => {
    const w = BY_EN[en];
    return { w, type: pick(candidates(w)) };
  });
  if (!queue.length) return;
  beginSession('review', queue, { title: 'Repaso' });
}
function beginSession(mode, queue, meta) {
  sess = { mode, meta, queue, size: queue.length, cur: null, correct: 0, total: 0, xp: 0, requeued: {} };
  view = { screen: 'session' };
  next();
}
function next() {
  if (!sess) return;
  if (!sess.queue.length) return finish();
  const it = sess.queue.shift();
  sess.cur = prepare(it);
  if (sess.cur.type === 'listen') {
    const c = sess.cur;
    setTimeout(() => { if (sess && sess.cur === c) speak(c.w.en); }, 300);
  }
  render();
}
function prepare(it) {
  const w = it.w;
  let type = it.type;
  if (type === 'reorder' && !w.ex) type = 'mc';
  if (type === 'speak' && !SR_CLASS) type = 'listen';
  const c = { w, type, answered: false, ok: false, chosen: -1, typed: '', build: [], status: '', listening: false };

  if (type === 'mc') {
    const dir = Math.random() < 0.5 ? 'en2es' : 'es2en';
    const f = dir === 'en2es' ? 'es' : 'en';
    c.prompt = dir === 'en2es' ? `¿Qué significa «${w.en}»?` : `¿Cómo se dice «${w.es}» en inglés?`;
    c.answer = w[f];
    c.opts = shuffle([c.answer, ...others(f, c.answer, 3)]);
  }
  if (type === 'listen') {
    c.answer = w.es;
    c.opts = shuffle([w.es, ...others('es', w.es, 3)]);
  }
  if (type === 'reorder') {
    c.tokens = w.ex.replace(/[.!?]$/, '').split(' ');
    c.bank = shuffle(c.tokens.map((_, i) => i));
  }
  return c;
}

/* ----- Acciones de ejercicio ----- */
function answerChoice(i) {
  const c = sess.cur;
  if (!c || c.answered) return;
  c.chosen = i;
  resolve(c.opts[i] === c.answer);
}
function submitType() {
  const c = sess.cur;
  if (!c || c.answered) return;
  const v = document.getElementById('ans')?.value || '';
  c.typed = v;
  const a = norm(v), t = norm(c.w.en);
  resolve(a === t || (t.length >= 5 && lev(a, t) <= 1));
}
function build(ti) {
  const c = sess.cur;
  if (!c || c.answered || c.build.includes(ti)) return;
  c.build.push(ti);
  render();
}
function unbuild(pos) {
  const c = sess.cur;
  if (!c || c.answered) return;
  c.build.splice(pos, 1);
  render();
}
function checkReorder() {
  const c = sess.cur;
  if (!c || c.answered || c.build.length !== c.tokens.length) return;
  resolve(c.build.every((ti, k) => ti === k));
}
function startMic() {
  const c = sess.cur;
  if (!c || c.answered || c.listening) return;
  if (!SR_CLASS) {
    c.status = 'Este navegador no admite reconocimiento de voz.';
    c.manual = true;
    render();
    return;
  }
  c.listening = true;
  c.status = 'Escuchando… habla ahora';
  render();
  const r = new SR_CLASS();
  r.lang = 'en-US';
  r.interimResults = true;
  r.maxAlternatives = 5;
  r.onresult = e => {
    const results = Array.from(e.results);
    const transcript = results.map(result => result[0].transcript).join(' ').trim();
    if (transcript) c.status = `Te escuché: «${transcript}»`;
    const finalResult = results.filter(result => result.isFinal).pop();
    if (!finalResult) {
      render();
      return;
    }
    c.listening = false;
    const alts = Array.from(finalResult).map(a => norm(a.transcript));
    const target = norm(c.w.en);
    const ok = alts.some(t => t === target
      || (target.includes(' ') && t.includes(target))
      || (target.length >= 5 && lev(t, target) <= 1));
    c.status = `Te escuché: «${finalResult[0].transcript}»`;
    resolve(ok);
  };
  r.onerror = e => {
    c.listening = false;
    c.manual = true;
    c.status = e.error === 'not-allowed' || e.error === 'service-not-allowed'
      ? 'Permite el acceso al micrófono en el navegador y vuelve a intentarlo.'
      : e.error === 'audio-capture'
        ? 'No se encontró un micrófono. Conecta uno y vuelve a intentarlo.'
        : e.error === 'no-speech'
          ? 'No detecté voz. Acércate al micrófono e inténtalo de nuevo.'
          : 'No se pudo reconocer la voz. Revisa el micrófono y la conexión, o escribe tu respuesta.';
    render();
  };
  r.onend = () => {
    if (c.listening) {
      c.listening = false;
      c.manual = true;
      c.status = 'No recibí una respuesta. Inténtalo otra vez o escribe lo que dijiste.';
      render();
    }
  };
  try {
    r.start();
  } catch (err) {
    c.listening = false;
    c.manual = true;
    c.status = err.name === 'NotAllowedError' || err.name === 'SecurityError'
      ? 'Permite el acceso al micrófono en el navegador y vuelve a intentarlo.'
      : err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError'
        ? 'No se encontró un micrófono. Conecta uno y vuelve a intentarlo.'
        : 'No se pudo iniciar el micrófono. Revisa los permisos del navegador e inténtalo de nuevo.';
    render();
  }
}
function showManualAnswer() {
  const c = sess && sess.cur;
  if (!c || c.answered) return;
  c.manual = true;
  render();
}
function skip() {
  const c = sess.cur;
  if (!c || c.answered) return;
  sess.queue.push({ w: c.w, type: c.type });
  next();
}

/* Resolución común de una respuesta */
function resolve(ok) {
  const c = sess.cur;
  if (!c || c.answered) return;
  c.answered = true;
  c.ok = ok;
  sess.total++;
  S.stats.total++;
  if (ok) {
    sess.correct++;
    S.stats.correct++;
    sess.xp += 10;
    addXP(10);
  }
  srs(c.w.en, ok);
  if (!ok && sess.mode === 'lesson' && !sess.requeued[c.w.en]) {
    sess.requeued[c.w.en] = true;
    sess.queue.push({ w: c.w, type: otherType(c.type, c.w) });
  }
  save();
  render();
}

function finish() {
  const pct = sess.total ? Math.round(sess.correct / sess.total * 100) : 0;
  const stars = pct >= 90 ? 3 : pct >= 70 ? 2 : 1;
  if (sess.mode === 'lesson') {
    const id = sess.meta.lessonId;
    const prev = S.lessons[id];
    S.lessons[id] = {
      best: Math.max(prev ? prev.best : 0, pct),
      stars: Math.max(prev ? prev.stars : 0, stars),
      attempts: (prev ? prev.attempts : 0) + 1
    };
  }
  save();
  view = { screen: 'summary', pct, stars, correct: sess.correct, total: sess.total, xp: sess.xp,
           mode: sess.mode, meta: sess.meta, title: sess.meta.title };
  sess = null;
  render();
}

function exitSession() {
  if (!confirm('¿Salir de la sesión? El progreso que ya hiciste se mantiene.')) return;
  sess = null;
  go('home');
}

