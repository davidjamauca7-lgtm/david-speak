}

function render() {
  const map = { home: renderHome, lesson: renderLesson, session: renderSession,
                summary: renderSummary, progress: renderProgress };
  document.getElementById('app').innerHTML = map[view.screen]();
  const inFlow = view.screen === 'session' || view.screen === 'summary';
  const nav = document.getElementById('nav');
  nav.style.display = inFlow ? 'none' : 'flex';
  nav.innerHTML = navHTML();
  window.scrollTo(0, 0);
}

render();
if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
  navigator.serviceWorker.register('./sw.js')
    .catch(error => console.error('No se pudo activar el modo app sin conexión:', error));
}
</script>


