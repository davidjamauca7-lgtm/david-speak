<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lenguajes</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f0ff;--card:#fff;--ink:#1d1a3b;--mute:#5f5c86;--pri:#4b3fd6;--pd:#3629b3;--sun:#ffc93c;--ok:#12875f;--okb:#d9f5e9;--bad:#d6333b;--badb:#fde0e1;--line:#d9d5f5;--fs:17px;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#16143a;--card:#221f4f;--ink:#f1efff;--mute:#b0acdc;--pri:#8a7dff;--pd:#a79dff;--line:#38337a;--okb:#0f3b2f;--badb:#4a1f26;--ok:#4fd9a6;--bad:#ff7a82}}
:root[data-theme="dark"]{--bg:#16143a;--card:#221f4f;--ink:#f1efff;--mute:#b0acdc;--pri:#8a7dff;--pd:#a79dff;--line:#38337a;--okb:#0f3b2f;--badb:#4a1f26;--ok:#4fd9a6;--bad:#ff7a82}
html{scroll-padding-top:env(safe-area-inset-top,0px)}*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:500 var(--fs)/1.45 "Bricolage Grotesque",system-ui,sans-serif;min-height:100vh}
main{max-width:600px;margin:0 auto;padding:18px 16px 60px}
h1{font-size:40px;margin:0;font-weight:800;letter-spacing:-1.5px;color:var(--pri)}h2{font-size:1.2em;margin:22px 0 8px}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px}.sub{color:var(--mute);margin:4px 0}
button,input{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible{outline:3px solid var(--sun);outline-offset:2px}
.card{background:var(--card);border:2px solid var(--line);border-radius:18px;padding:14px 16px;margin:10px 0;width:100%;text-align:left;display:block}
button.card:hover{border-color:var(--pri)}
.pill{background:var(--sun);color:#3b2e00;padding:5px 12px;border-radius:99px;font-weight:800;font-size:.9em}
.bar{height:12px;background:var(--line);border-radius:99px;overflow:hidden;flex:1}.bar i{display:block;height:100%;background:var(--pri);transition:width .3s}
.mr{display:flex;align-items:center;gap:10px;margin-top:8px}
.btn{background:var(--pri);color:#fff;border:0;border-bottom:4px solid var(--pd);border-radius:14px;padding:11px 20px;font-weight:800}
.btn.alt{background:var(--card);color:var(--ink);border:2px solid var(--line)}
.opt{background:var(--card);border:2px solid var(--line);border-bottom-width:5px;border-radius:14px;padding:13px 15px;text-align:left;font-weight:700;display:block;width:100%;margin-top:10px}
.opt.ok{background:var(--okb);border-color:var(--ok)}.opt.bad{background:var(--badb);border-color:var(--bad)}
.big{font-size:1.9em;font-weight:800;line-height:1.15;margin:8px 0}
.fb{position:sticky;bottom:0;margin:20px -16px -60px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.fb.ok{background:var(--okb);color:var(--ok)}.fb.bad{background:var(--badb);color:var(--bad)}.fb div{color:var(--ink)}
input.in{width:100%;padding:13px;border:2px solid var(--line);border-radius:12px;background:var(--card);margin-top:10px}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.x{background:none;border:0;font-size:1.5em;color:var(--mute)}
.tag{font-size:.8em;color:var(--mute)}.say{background:var(--pri);color:#fff;border:0;border-radius:50%;width:52px;height:52px;font-size:22px}
</style></head><body><main id="app"></main>
<script>
const V=[
["Saludos","Hola, me llamo Ana","Hello, my name is Ana","«My name is» equivale a «me llamo»."],
["Saludos","¿Cómo estás?","How are you?","Se usa para saludar; responde «I'm fine, thanks»."],
["Saludos","Mucho gusto","Nice to meet you","Se dice al conocer a alguien por primera vez."],
["Saludos","Soy de Colombia","I'm from Colombia","I'm = I am. Con países usamos «from»."],
["Saludos","Hasta luego","See you later","Despedida informal muy común."],
["Comida","Quisiera un café, por favor","I would like a coffee, please","«I would like» es más amable que «I want»."],
["Comida","La cuenta, por favor","The check, please","En Reino Unido dicen «the bill»."],
["Comida","¿Qué recomienda?","What do you recommend?","Pregunta útil para pedir sugerencias."],
["Comida","Soy alérgico a las nueces","I'm allergic to nuts","«Allergic to» + alimento."],
["Comida","Agua sin gas","Still water","«Still» aquí significa sin burbujas."],
["Viaje","¿Dónde está el baño?","Where is the bathroom?","En preguntas, «where» va al inicio."],
["Viaje","¿Cuánto cuesta?","How much is it?","Sirve para preguntar precios."],
["Viaje","Necesito un taxi","I need a taxi","«I need» + sustantivo."],
["Viaje","¿A qué hora sale el tren?","What time does the train leave?","Con «does» el verbo va en base: leave, no leaves."],
["Viaje","Tengo una reserva","I have a reservation","«Reservation» se parece a «reserva», pero ojo con la pronunciación."],
["Trabajo","Tengo una reunión a las tres","I have a meeting at three","Con horas se usa «at»."],
["Trabajo","¿Puede enviarme el informe?","Can you send me the report?","«Can you...?» es una petición cortés."],
["Trabajo","Estoy de acuerdo","I agree","En inglés no se dice «I am agree»."],
["Trabajo","Llego tarde","I'm running late","Frase natural; literal sería «arrive late»."],
["Trabajo","Le llamo mañana","I'll call you tomorrow","I'll = I will, para promesas o decisiones."],
["Gramática","Completa: She ___ coffee every day.","drinks","En tercera persona del singular (she/he/it) el verbo lleva -s.",["drinks","drink","drinking"]],
["Gramática","Completa: I ___ from Colombia.","am","Con «I» se usa «am».",["am","is","are"]],
["Gramática","Completa: We ___ a meeting yesterday.","had","«Yesterday» pide pasado: had.",["had","have","has"]],
["Gramática","Completa: Do you ___ English?","speak","Después de «do» el verbo va en forma base.",["speak","speaks","spoke"]]];
const TP={Saludos:1,Comida:1,Viaje:2,Trabajo:3,"Gramática":1};
const GOALS={viajar:["Viaje","Comida","Saludos","Gramática","Trabajo"],trabajo:["Trabajo","Saludos","Gramática","Viaje","Comida"],conversar:["Saludos","Comida","Gramática","Viaje","Trabajo"]};
const SC=[
["🍽️ En el restaurante",[["Good evening! What would you like to drink?",["I would like water, please.","I am water, please.","Water is me."],"Para pedir con cortesía usa «I would like... please»."],["Would you like anything to eat?",["What do you recommend?","I recommend you.","Where is the bus?"],"«What do you recommend?» pide una sugerencia."],["Here you go.",["The check, please.","The check me, please.","I pay yes."],"«The check, please» pide la cuenta."]]],
["🏨 En el hotel",[["Welcome! Do you have a reservation?",["Yes, I have a reservation.","Yes, I am reservation.","No, I reservation."],"Para posesión o reservas usa «I have»."],["May I see your passport?",["Here you are.","I passport you.","Yes, passport."],"«Here you are» al entregar algo."],["Your room is on the third floor.",["Thank you very much.","Third thank you.","Room is you."],"Agradece con «Thank you (very much)»."]]],
["💼 En el trabajo",[["Are you free at three?",["I have a meeting, but I'm free at four.","I am meeting at three free.","No free three."],"Con horas se usa «at»; «but» une la contraposición."],["Can you send me the report?",["Sure, I'll send it today.","Sure, I send yesterday.","Report is no."],"«I'll» expresa una decisión o promesa."]]]];
const DAILY={1:"Tranquilo · 1 lección",2:"Constante · 2 lecciones",3:"Intenso · 3 lecciones"};
let S={goal:null,daily:2,lvl:null,srs:{},days:{},streak:0,last:"",fs:17,slow:false};
try{Object.assign(S,JSON.parse(localStorage.getItem("leng2")||"{}"))}catch(e){}
const save=()=>{try{localStorage.setItem("leng2",JSON.stringify(S))}catch(e){}};
const $=document.getElementById("app"),sh=a=>[...a].sort(()=>Math.random()-.5);
const today=()=>new Date().toISOString().slice(0,10);
const norm=s=>s.toLowerCase().replace(/[’']/g,"").replace(/[^a-z0-9 ]/g," ").replace(/\s+/g," ").trim();
const say=t=>{try{const u=new SpeechSynthesisUtterance(t);u.lang="en-US";u.rate=S.slow?.6:.9;speechSynthesis.cancel();speechSynthesis.speak(u)}catch(e){}};
const ids=t=>V.map((v,i)=>v[0]===t?i:-1).filter(i=>i>=0);
const mast=t=>{const a=ids(t);return a.reduce((s,i)=>s+((S.srs[i]||{b:0}).b),0)/(5*a.length)};
const due=()=>Object.keys(S.srs).filter(i=>S.srs[i].d<=Date.now()).map(Number);
const upd=(i,ok)=>{const b=ok?Math.min(5,(S.srs[i]?S.srs[i].b:0)+1):1;S.srs[i]={b,d:Date.now()+[0,0,1,2,4,8][b]*864e5};save()};
const css=()=>document.documentElement.style.setProperty("--fs",S.fs+"px");css();
function start(){S.goal?(S.lvl?home():place()):onb()}
function onb(){
$.innerHTML=`<h1>Lenguajes</h1><p class="sub">Aprende inglés con práctica corta cada día. ¿Para qué lo quieres?</p>
${[["viajar","✈️ Para viajar"],["trabajo","💼 Para el trabajo"],["conversar","💬 Para conversar"]].map(g=>`<button class="card" data-g="${g[0]}">${g[1]}</button>`).join("")}
<h2>¿Qué ritmo prefieres?</h2>${[1,2,3].map(n=>`<button class="card" data-d="${n}">${DAILY[n]}</button>`).join("")}<p class="sub" id="m"></p>`;
let g=null,d=null;const chk=()=>{if(g&&d){S.goal=g;S.daily=d;save();place()}};
$.querySelectorAll("[data-g]").forEach(b=>b.onclick=()=>{g=b.dataset.g;$.querySelectorAll("[data-g]").forEach(x=>x.style.borderColor="");b.style.borderColor="var(--pri)";chk()});
$.querySelectorAll("[data-d]").forEach(b=>b.onclick=()=>{d=+b.dataset.d;$.querySelectorAll("[data-d]").forEach(x=>x.style.borderColor="");b.style.borderColor="var(--pri)";chk()})}
function place(){
const pick=l=>sh(V.map((v,i)=>[v,i]).filter(x=>x[0][0]!=="Gramática"&&TP[x[0][0]]===l)).slice(0,2).map(x=>x[1]);
E={mode:"place",list:[...pick(1),...pick(2),...pick(3)].map(i=>({i,k:"choose"})),n:0,ok:0,lv:{}};
$.innerHTML=`<h1>Prueba inicial</h1><p class="sub">6 preguntas para adaptar las lecciones a tu nivel. Si no sabes, elige lo que creas.</p><div class="row"><button class="btn" id="go">Empezar</button></div>`;
document.getElementById("go").onclick=ask}
let E=null;
function ask(){
const x=E.list[E.n],v=V[x.i],k=x.k,tot=E.list.length;
const pool=sh(V.map((_,i)=>i).filter(i=>i!==x.i&&V[i][0]!=="Gramática")).slice(0,3);
const o=sh([x.i,...pool]);let body="",opts="";
if(k==="choose"){body=`<p class="tag">Lectura · ¿Cómo se dice en inglés?</p><div class="big">${v[1]}</div>`;opts=o.map(i=>`<button class="opt" data-i="${i}">${V[i][2]}</button>`).join("")}
if(k==="listen"){body=`<p class="tag">Escucha · elige el significado</p><button class="say" id="sy" aria-label="Escuchar">🔊</button>`;opts=o.map(i=>`<button class="opt" data-i="${i}">${V[i][1]}</button>`).join("")}
if(k==="fill"){body=`<p class="tag">Gramática</p><div class="big">${v[1].replace("Completa: ","")}</div>`;opts=sh(v[4]).map(t=>`<button class="opt" data-t="${t}">${t}</button>`).join("")}
if(k==="write"){body=`<p class="tag">Escritura · escríbelo en inglés</p><div class="big">${v[1]}</div>`;opts=`<input class="in" id="in" autocomplete="off" aria-label="Tu respuesta"><div class="row"><button class="btn" id="ok">Comprobar</button></div>`}
if(k==="speak"){body=`<p class="tag">Pronunciación · escucha y repite</p><div class="big">${v[2]}</div><div class="row"><button class="say" id="sy" aria-label="Escuchar">🔊</button><button class="btn" id="rc">🎤 Grabar mi voz</button></div><div id="sf"></div>`}
$.innerHTML=`<div class="top"><button class="x" id="q" aria-label="Salir">✕</button><div class="bar"><i style="width:${E.n/tot*100}%"></i></div></div><div style="margin-top:18px">${body}</div>${opts}<div id="fb"></div>`;
document.getElementById("q").onclick=home;
const sy=document.getElementById("sy");if(sy){sy.onclick=()=>say(v[2]);if(k==="listen")say(v[2])}
$.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{$.querySelectorAll(".opt").forEach(z=>z.disabled=true);const g=k==="fill"?b.dataset.t===v[2]:+b.dataset.i===x.i;b.classList.add(g?"ok":"bad");if(!g)$.querySelectorAll(".opt").forEach(z=>{if(k==="fill"?z.dataset.t===v[2]:+z.dataset.i===x.i)z.classList.add("ok")});done(g)});
const ob=document.getElementById("ok");if(ob){const f=()=>{const a=document.getElementById("in").value;ob.disabled=true;done(norm(a)===norm(v[2]),a)};ob.onclick=f;document.getElementById("in").onkeydown=e=>{if(e.key==="Enter")f()};document.getElementById("in").focus()}
const rc=document.getElementById("rc");if(rc)rc.onclick=()=>{rc.disabled=true;rc.textContent="Escuchando…";const R=window.SpeechRecognition||window.webkitSpeechRecognition;
const self=()=>{document.getElementById("sf").innerHTML=`<p class="sub">No pude usar el micrófono. Di la frase en voz alta, compárala con el audio y evalúate:</p><div class="row"><button class="btn" id="y">Lo dije bien</button><button class="btn alt" id="n">Necesito repetir</button></div>`;document.getElementById("y").onclick=()=>done(true);document.getElementById("n").onclick=()=>done(false,null,"Escucha de nuevo y repite más despacio.")};
if(!R)return self();try{const r=new R();r.lang="en-US";r.onerror=self;r.onresult=e=>{const h=norm(e.results[0][0].transcript).split(" "),t=norm(v[2]).split(" "),miss=t.filter(w=>!h.includes(w));const sc=Math.round(100*(t.length-miss.length)/t.length);done(sc>=70,null,`Entendí: «${e.results[0][0].transcript}» (${sc}%).`+(miss.length?` Practica: ${miss.join(", ")}.`:""))};r.start()}catch(e){self()}}}
function done(g,typed,extra){
const x=E.list[E.n],v=V[x.i];if(g)E.ok++;
if(E.mode==="place"){const l=TP[v[0]];E.lv[l]=(E.lv[l]||0)+(g?1:0)}else upd(x.i,g);
const ans=v[2]+(g||x.k!=="write"?"":"");
document.getElementById("fb").innerHTML=`<div class="fb ${g?"ok":"bad"}"><div><b>${g?"¡Bien!":"Casi. Respuesta: "+v[2]}</b><br>${extra||(E.mode==="place"?"":v[3])}</div><button class="btn" id="nx">${E.n===E.list.length-1?"Terminar":"Continuar"}</button></div>`;
say(v[2]);const nx=document.getElementById("nx");nx.focus();nx.onclick=()=>{E.n++;E.n<E.list.length?ask():fin()}}
function bump(){const t=today();S.days[t]=(S.days[t]||0)+1;if(S.last!==t){const y=new Date(Date.now()-864e5).toISOString().slice(0,10);S.streak=S.last===y?S.streak+1:1;S.last=t}save()}
function fin(){
if(E.mode==="place"){const s=E.ok;S.lvl=s<=2?1:s<=4?2:3;save();
$.innerHTML=`<div style="text-align:center;padding-top:30px"><div class="big">🎯</div><h1 style="font-size:32px">Tu nivel: ${["","A1 · Inicial","A2 · Básico","B1 · Intermedio"][S.lvl]}</h1><p class="sub">Acertaste ${s} de 6. Adaptamos tu plan a tu objetivo.</p><div class="row" style="justify-content:center"><button class="btn" id="h">Ver mi plan</button></div></div>`;document.getElementById("h").onclick=home;return}
bump();const pct=Math.round(E.ok/E.list.length*100);
$.innerHTML=`<div style="text-align:center;padding-top:30px"><div class="big">${pct>=75?"🏆":"💪"}</div><h1 style="font-size:32px">Lección completada</h1><p class="sub">${E.ok} de ${E.list.length} correctas · Hoy: ${S.days[today()]}/${S.daily} lecciones · Racha: ${S.streak} día(s)</p><p class="sub">${pct>=75?"Vas muy bien. Lo que falles volverá en tu repaso.":"Lo que falló volverá en tu repaso para que lo fijes."}</p><div class="row" style="justify-content:center"><button class="btn" id="h">Continuar</button></div></div>`;document.getElementById("h").onclick=home}
function lesson(t){const a=sh(ids(t)).slice(0,4);const K=["choose","listen","write","speak"];
E={mode:"les",n:0,ok:0,list:t==="Gramática"?a.map(i=>({i,k:"fill"})):sh(a.flatMap((i,j)=>[{i,k:K[(2*j)%4]},{i,k:K[(2*j+1)%4]}]))};ask()}
function review(){const K=["choose","listen","write","speak"];E={mode:"rev",n:0,ok:0,list:sh(due()).slice(0,6).map(i=>({i,k:V[i][0]==="Gramática"?"fill":K[Math.floor(Math.random()*3)]}))};ask()}
function scen(n){const s=SC[n];let t=0,ok=0;
const turn=()=>{const [l,o,nt]=s[1][t],oo=sh(o.map((x,i)=>[x,i]));
$.innerHTML=`<div class="top"><button class="x" id="q" aria-label="Salir">✕</button><div class="bar"><i style="width:${t/s[1].length*100}%"></i></div></div><p class="tag">${s[0]} · responde</p><div class="big">${l}</div><button class="say" id="sy" aria-label="Escuchar">🔊</button>${oo.map(x=>`<button class="opt" data-c="${x[1]}">${x[0]}</button>`).join("")}<div id="fb"></div>`;
document.getElementById("q").onclick=home;document.getElementById("sy").onclick=()=>say(l);say(l);
$.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{const g=b.dataset.c==="0";if(g)ok++;$.querySelectorAll(".opt").forEach(z=>{z.disabled=true;if(z.dataset.c==="0")z.classList.add("ok")});if(!g)b.classList.add("bad");
document.getElementById("fb").innerHTML=`<div class="fb ${g?"ok":"bad"}"><div><b>${g?"¡Buena respuesta!":"Mejor opción: "+o[0]}</b><br>${nt}</div><button class="btn" id="nx">Continuar</button></div>`;
const nx=document.getElementById("nx");nx.focus();nx.onclick=()=>{t++;if(t<s[1].length)turn();else{bump();E={mode:"sc",ok,list:s[1]};$.innerHTML=`<div style="text-align:center;padding-top:30px"><div class="big">🎭</div><h1 style="font-size:32px">Situación completada</h1><p class="sub">${ok} de ${s[1].length} respuestas naturales.</p><div class="row" style="justify-content:center"><button class="btn" id="h">Volver</button></div></div>`;document.getElementById("h").onclick=home}}})};turn()}
function home(){
const d=S.days[today()]||0,n=due().length,ord=GOALS[S.goal];
$.innerHTML=`<div class="top"><h1>Lenguajes</h1><span class="pill">🔥 ${S.streak}</span></div>
<p class="sub">Nivel ${["","A1","A2","B1"][S.lvl]} · Meta: ${{viajar:"viajar",trabajo:"el trabajo",conversar:"conversar"}[S.goal]}</p>
<div class="card"><b>Hoy: ${Math.min(d,S.daily)} de ${S.daily} lecciones</b><div class="mr"><div class="bar"><i style="width:${Math.min(100,d/S.daily*100)}%"></i></div></div><p class="sub" style="margin:8px 0 0">${d>=S.daily?"¡Meta cumplida! Puedes seguir si quieres.":"Poco cada día funciona mejor que mucho un día."}</p></div>
<button class="card" id="rv" ${n?"":"disabled"}><b>🔁 Repaso inteligente</b><br><span class="sub">${n?n+" frases por repasar hoy":"Nada pendiente por ahora. Completa lecciones para activarlo."}</span></button>
<h2>Lecciones</h2>${ord.map(t=>`<button class="card" data-t="${t}"><b>${t}</b> <span class="tag">${["","Nivel A1","Nivel A2","Nivel B1"][TP[t]]}${TP[t]>S.lvl?" · más adelante":""}</span><div class="mr"><div class="bar" role="img" aria-label="Dominio ${Math.round(mast(t)*100)}%"><i style="width:${mast(t)*100}%"></i></div><span class="tag">${Math.round(mast(t)*100)}%</span></div></button>`).join("")}
<h2>Situaciones reales</h2>${SC.map((s,i)=>`<button class="card" data-s="${i}">${s[0]}</button>`).join("")}
<h2>Ajustes</h2><div class="row"><button class="btn alt" id="fm">A−</button><button class="btn alt" id="fp">A+</button><button class="btn alt" id="sl">Audio lento: ${S.slow?"sí":"no"}</button><button class="btn alt" id="rs">Cambiar objetivo</button></div>`;
document.getElementById("rv").onclick=review;
$.querySelectorAll("[data-t]").forEach(b=>b.onclick=()=>lesson(b.dataset.t));$.querySelectorAll("[data-s]").forEach(b=>b.onclick=()=>scen(+b.dataset.s));
document.getElementById("fm").onclick=()=>{S.fs=Math.max(14,S.fs-2);save();css()};document.getElementById("fp").onclick=()=>{S.fs=Math.min(26,S.fs+2);save();css()};
document.getElementById("sl").onclick=()=>{S.slow=!S.slow;save();home()};document.getElementById("rs").onclick=()=>{S.goal=null;S.lvl=null;save();start()}}
start();
</script></body></html>
